generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum TripVisibility {
  PRIVATE
  LINK
  PUBLIC
}

enum ActivityType {
  HIKE
  BIKE
  RUN
  KAYAK
  DRIVE
  BOAT
  SIGHTSEEING
  FOOD
  OTHER
}

enum TrackSource {
  GPX
  FIT
  GOOGLE
}

enum PhotoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Why a family member moved an item to the trash. Recorded so an admin deciding whether to restore it can see the
/// reason without having to ask, and so "someone asked me to remove it" is never mistaken for "it was blurry".
/// How closely an estimated place is pinned. Anywhere private is placed at CITY or wider, never at the address.
enum PlacePrecision {
  EXACT
  CITY
  REGION
}

enum TrashReason {
  BLURRY
  DUPLICATE
  ACCIDENT
  PRIVATE
  SOMEONE_ASKED
  NOT_WORTH_KEEPING
  OTHER
}

enum GpsSource {
  EXIF
  TRACK
  MANUAL
  SIDECAR
  ESTIMATE
}

enum TakenAtSource {
  EXIF_OFFSET
  EXIF_TZLOOKUP
  TRIP_TZ
  /// The capture time phones write into the file name (IMG_20250812_143015, PXL_…, Screenshot_…). Worth far more
  /// than the file's modified time, which is usually when the file was copied rather than when the photo was taken.
  FILE_NAME
  /// DateTimeDigitized, reached only when the capture time was stripped. A photo editor often rewrites this tag to
  /// the day it exported the file, so it is worth showing but never worth trusting.
  EXIF_CREATED
  FILE_MTIME
  UPLOAD_TIME
  MANUAL
  SIDECAR
}

/// What a media row is: an uploaded photo, an uploaded short clip, or a video hosted elsewhere (YouTube) and embedded.
enum MediaKind {
  PHOTO
  VIDEO
  EXTERNAL_VIDEO
}

enum MediaSourceKind {
  UPLOAD
  YOUTUBE
  TAKEOUT
  GOOGLE_PICKER
}

enum TakeoutImportStatus {
  RUNNING
  ENDED
  FAILED
}

enum AnimalStatus {
  DETECTED
  PROPOSED
  CONFIRMED
  REJECTED
}

enum ExternalProvider {
  YOUTUBE
}

enum ExternalStatus {
  AVAILABLE
  UNAVAILABLE
}

enum AnnotationSource {
  MACHINE
  EDITED
}

enum EstimatedDateSource {
  MODEL
  MEMBER
}

enum AnnotationBatchStatus {
  SUBMITTED
  ENDED
  CANCELLED
  FAILED
}

enum PersonKind {
  HUMAN
  PET
}

enum Species {
  DOG
  CAT
  CHICKEN
  HORSE
  OTHER
}

enum FaceStatus {
  DETECTED
  PROPOSED
  CONFIRMED
  REJECTED
}

enum PhotoRelation {
  SAME_SCENE
  BEFORE_AFTER
  PANORAMA_PART
  DETAIL_OF
  RELATED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  sessions Session[]
  googleAccount GoogleAccount?
  invites  Invite[]  @relation("InvitedBy")
  trips    Trip[]
  photos   Photo[]
  placesSet Photo[] @relation("PlaceSetBy")
  trashed   Photo[] @relation("TrashedBy")
  edited    Photo[] @relation("EditedBy")
  datesSet  Photo[] @relation("DateSetBy")
  tracks   Track[]
  collections     Collection[]
  collectionItems CollectionItem[]
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  role        Role      @default(MEMBER)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Trip {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String?
  startDate    DateTime       @db.Date
  endDate      DateTime       @db.Date
  timezone     String         @default("UTC")
  themeKey     String         @default("default")
  coverPhotoId String?        @unique
  coverPhoto   Photo?         @relation("TripCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  visibility   TripVisibility @default(PRIVATE)
  shareToken   String?        @unique
  annotationOptOut Boolean    @default(false)
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  activities Activity[]
  photos     Photo[]
  tracks     Track[]

  @@index([startDate])
  @@index([visibility])
}

model Activity {
  id          String       @id @default(cuid())
  tripId      String
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  type        ActivityType @default(OTHER)
  startTime   DateTime
  endTime     DateTime
  description String?
  trackId     String?      @unique
  track       Track?       @relation("ActivityTrack", fields: [trackId], references: [id], onDelete: SetNull)
  photos      Photo[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([tripId, startTime])
}

model Photo {
  id            String         @id @default(cuid())
  tripId        String?
  trip          Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  activityId    String?
  activity      Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  uploaderId    String
  uploader      User           @relation(fields: [uploaderId], references: [id])
  /// Who pinned this item's place by hand, and who set its date by hand, so the album can say whose choice it was.
  placeSetById  String?
  placeSetBy    User?          @relation("PlaceSetBy", fields: [placeSetById], references: [id], onDelete: SetNull)
  dateSetById   String?
  dateSetBy     User?          @relation("DateSetBy", fields: [dateSetById], references: [id], onDelete: SetNull)
  status        PhotoStatus    @default(PENDING)
  error         String?
  originalName  String
  mimeType      String
  storageKey    String
  originalPath  String
  sizeBytes     Int
  width         Int?
  height        Int?
  takenAt       DateTime?
  takenAtSource TakenAtSource?
  tzOffsetMin   Int?
  lat           Float?
  lng           Float?
  altitude      Float?
  gpsSource     GpsSource?
  camera        String?
  lens          String?
  exif          Json?
  caption       String?
  renditions    Json?
  kind          MediaKind         @default(PHOTO)
  sourceKind    MediaSourceKind   @default(UPLOAD)
  provider      ExternalProvider?
  externalId    String?
  externalUrl   String?
  title         String?
  externalStatus    ExternalStatus?
  externalCheckedAt DateTime?
  durationS     Float?
  videoRenditions Json?
  /// Free text the uploader added at review time ("Grandma Jo's 80th at the lake house"); feeds search and annotation.
  context          String?
  contextUpdatedAt DateTime?
  reviewedAt       DateTime?
  /// Structured description from the AI helper (caption, description, tags, place, ...). Machine-generated until a member edits it.
  annotation        Json?
  annotationModel   String?
  annotatedAt       DateTime?
  annotationSource  AnnotationSource?
  /// A refusal or failure reason code from the last attempt; never the content.
  annotationError   String?
  /// Never send this item to the AI helper (also inherited from its trip and collections).
  annotationOptOut  Boolean  @default(false)
  /// Token counts from the helper's last response, for the admin page's real-spend figure.
  annotationInputTokens     Int?
  annotationCacheReadTokens Int?
  annotationCacheWriteTokens Int?
  annotationOutputTokens    Int?
  annotationBatched         Boolean?
  /// Darkroom edits, kept as instructions rather than applied to the file: crop, straighten, brightness, contrast,
  /// colour. The original is never touched, the renditions are re-rendered from it whenever this changes, and
  /// clearing it puts the item back exactly as it arrived. Only the uploader or an admin may set it.
  edits         Json?
  editedAt      DateTime?
  editedById    String?
  editedBy      User?          @relation("EditedBy", fields: [editedById], references: [id], onDelete: SetNull)
  /// What the place is called, when the album knows: the name a member picked out of the address lookup, or the one
  /// they accepted from the helper. Coordinates are exact but say nothing; this is what a family reads.
  placeName     String?
  /// In the trash: hidden everywhere and skipped by every background job, but still on disk until an admin decides.
  /// Any member may trash an item and must give a reason; only an admin can restore it or delete it for good.
  trashedAt     DateTime?
  trashedById   String?
  trashedBy     User?          @relation("TrashedBy", fields: [trashedById], references: [id], onDelete: SetNull)
  trashReason   TrashReason?
  trashNote     String?
  /// For items with no recorded position: the helper's guess at a recognisable public place, with the evidence it
  /// used, so the album can always say where the pin came from. placeEstimatedAt is set even when the helper declined
  /// to guess, so a backfill asks about each item once.
  placeEstimateName       String?
  placeEstimateConfidence Float?
  placeEstimateRadiusM    Int?
  /// How closely the helper placed it: EXACT for a public place it could point at, CITY for the town something
  /// private sits in (never the building or the street), REGION for a wider area.
  placeEstimatePrecision  PlacePrecision?
  placeEstimateNote       String?
  placeEstimatedAt        DateTime?
  /// For undated items: the helper's estimated year range, kept until a member sets a real date.
  estimatedDate           DateTime?
  estimatedDateConfidence Float?
  estimatedDateSource     EstimatedDateSource?
  estimatedDateNote       String?
  /// Full-text index over caption, context, title, place and container titles: the only column anonymous search queries.
  searchVector        Unsupported("tsvector")?
  /// Adds people's, pets' and the uploader's names; queried for members only.
  searchVectorMembers Unsupported("tsvector")?
  /// OpenCLIP ViT-B/32 image embedding (cosine), for similarity, suggestions and the graph.
  embedding     Unsupported("vector(512)")?
  /// all-MiniLM-L6-v2 embedding of the description text, for semantic search.
  textEmbedding Unsupported("vector(384)")?
  embeddedAt    DateTime?
  facesDetectedAt DateTime?
  animalsDetectedAt DateTime?
  /// sha256 of the original file, for duplicate detection on imports.
  contentHash   String?
  /// The source system's own id (a Google media item id), so re-importing the same item is detected.
  sourceId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  coverOf     Trip?            @relation("TripCover")
  linksA      PhotoLink[]      @relation("LinkA")
  linksB      PhotoLink[]      @relation("LinkB")
  collections CollectionItem[]
  coverOfCollection Collection? @relation("CollectionCover")
  annotationRaw     MediaAnnotationRaw[]
  faces             Face[]
  animals           AnimalDetection[]
  similarA          MediaSimilarity[] @relation("SimA")
  similarB          MediaSimilarity[] @relation("SimB")

  @@index([takenAt])
  @@index([tripId, takenAt])
  @@index([activityId])
  @@index([lat, lng])
  @@index([status])
  @@index([kind])
  @@index([contentHash])
  @@index([sourceKind, sourceId])
  @@index([provider, externalId])
  @@index([reviewedAt])
  @@index([trashedAt])
}

/// A named, themed, shareable set of media that is independent of trips. A photo may sit in any number of collections.
model Collection {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String?
  themeKey     String         @default("default")
  visibility   TripVisibility @default(PRIVATE)
  shareToken   String?        @unique
  coverPhotoId String?        @unique
  coverPhoto   Photo?         @relation("CollectionCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  annotationOptOut Boolean    @default(false)
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items CollectionItem[]

  @@index([visibility])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  photoId      String
  photo        Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  addedById    String
  addedBy      User       @relation(fields: [addedById], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([collectionId, photoId])
  @@index([photoId])
  @@index([collectionId, position])
}

/// Single-row settings that need an audit trail: who turned a data-leaving feature on, and when.
model AppSetting {
  id                     String    @id @default("app")
  annotationOptInAt      DateTime?
  annotationOptInById    String?
  faceDetectionOptInAt   DateTime?
  faceDetectionOptInById String?
  faceDataDeletedAt      DateTime?
  updatedAt              DateTime  @updatedAt
}

/// The helper's raw response, kept briefly for debugging and purged by a scheduled job; deleted with the item.
model MediaAnnotationRaw {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  model     String
  response  Json
  createdAt DateTime @default(now())

  @@index([photoId])
  @@index([createdAt])
}

/// A backfill submitted through the Message Batches API.
model AnnotationBatch {
  id               String                @id @default(cuid())
  anthropicBatchId String                @unique
  status           AnnotationBatchStatus @default(SUBMITTED)
  scope            Json
  requested        Int
  succeeded        Int                   @default(0)
  errored          Int                   @default(0)
  /// Requests the run was stopped before the helper processed them: not failures, and still eligible for a later run.
  canceled         Int                   @default(0)
  skipped          Int                   @default(0)
  /// The row the admin started; chunk rows point at it so one cancel stops the whole run.
  parentId         String?
  /// Why items in scope were not sent, e.g. {"noRendition": 2}.
  skippedReasons   Json?
  /// On the row the admin started: when the worker picked the run up, when the admin asked to stop, and when the loop finished.
  startedAt        DateTime?
  cancelRequestedAt DateTime?
  runEndedAt       DateTime?
  createdById      String
  createdAt        DateTime              @default(now())
  endedAt          DateTime?

  @@index([parentId])
}

/// A family member or a pet. Recognition data lives in Face and FaceCluster and follows the consent fields here.
model Person {
  id                  String     @id @default(cuid())
  kind                PersonKind @default(HUMAN)
  name                String
  relationship        String?
  birthday            DateTime?  @db.Date
  species             Species?
  livedFrom           DateTime?  @db.Date
  livedTo             DateTime?  @db.Date
  isFlock             Boolean    @default(false)
  /// Matching and template storage are allowed for this person. Off until an admin turns it on.
  faceIndexing        Boolean    @default(false)
  faceIndexingSetById String?
  faceIndexingSetAt   DateTime?
  /// "I confirm this person is an adult and has agreed to face recognition", when no birthday is known.
  adultAttestedById   String?
  adultAttestedAt     DateTime?
  /// Named by a member: waits for an admin's consent decision (embeddings kept until then, capped by retention).
  pendingDecision     Boolean    @default(false)
  /// The person asked to be forgotten by the recogniser but kept their name on confirmed photos.
  keepNameOnPhotos    Boolean    @default(false)
  /// For pets: colour and breed words ("black lab", "ginger tabby") that narrow automatic matching.
  descriptors         String?
  /// Asked to be forgotten by the recogniser: excluded from the members' name index and from every proposal.
  optedOutAt          DateTime?
  createdById         String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  clusters FaceCluster[]
  faces    Face[]        @relation("FacePerson")
  proposed Face[]        @relation("FaceProposed")
  animals  AnimalDetection[] @relation("AnimalPerson")
  animalsProposed AnimalDetection[] @relation("AnimalProposed")

  @@index([name])
}

/// A group of similar faces. Named clusters belong to a person; one person may own several (one per era).
model FaceCluster {
  id          String   @id @default(cuid())
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  label       String?
  ageBandMin  Int?
  ageBandMax  Int?
  centroid    Unsupported("vector(512)")?
  faceCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faces Face[]

  @@index([personId])
}

/// One detected face. The embedding is the biometric template and is NULLed or deleted per the consent rules.
model Face {
  id                String     @id @default(cuid())
  photoId           String
  photo             Photo      @relation(fields: [photoId], references: [id], onDelete: Cascade)
  clusterId         String?
  cluster           FaceCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  personId          String?
  person            Person?    @relation("FacePerson", fields: [personId], references: [id], onDelete: SetNull)
  proposedPersonId  String?
  proposedPerson    Person?    @relation("FaceProposed", fields: [proposedPersonId], references: [id], onDelete: SetNull)
  /// x, y, w, h as fractions of the image.
  box               Json
  embedding         Unsupported("vector(512)")?
  confidence        Float
  ageAtCaptureYears Float?
  status            FaceStatus @default(DETECTED)
  createdAt         DateTime   @default(now())

  @@index([photoId])
  @@index([clusterId])
  @@index([personId])
  @@index([status])
}

/// Precomputed nearest neighbours by image embedding (cosine), stored once per unordered pair with photoAId < photoBId.
model MediaSimilarity {
  photoAId String
  photoA   Photo  @relation("SimA", fields: [photoAId], references: [id], onDelete: Cascade)
  photoBId String
  photoB   Photo  @relation("SimB", fields: [photoBId], references: [id], onDelete: Cascade)
  score    Float

  @@id([photoAId, photoBId])
  @@index([photoBId])
  @@index([score])
}

/// One animal found by the sidecar's detector: species, box and a whole-animal image embedding for matching pets.
model AnimalDetection {
  id               String       @id @default(cuid())
  photoId          String
  photo            Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  species          Species
  box              Json
  embedding        Unsupported("vector(512)")?
  confidence       Float
  personId         String?
  person           Person?      @relation("AnimalPerson", fields: [personId], references: [id], onDelete: SetNull)
  proposedPersonId String?
  proposedPerson   Person?      @relation("AnimalProposed", fields: [proposedPersonId], references: [id], onDelete: SetNull)
  status           AnimalStatus @default(DETECTED)
  createdAt        DateTime     @default(now())

  @@index([photoId])
  @@index([personId])
  @@index([status])
}

/// A Google Takeout archive import run, started by an admin from the server inbox.
model TakeoutImport {
  id                 String              @id @default(cuid())
  archiveName        String
  status             TakeoutImportStatus @default(RUNNING)
  imported           Int                 @default(0)
  skipped            Int                 @default(0)
  failed             Int                 @default(0)
  repaired           Int                 @default(0)
  collectionsCreated Int                 @default(0)
  report             Json?
  startedById        String
  startedAt          DateTime            @default(now())
  heartbeatAt        DateTime?
  endedAt            DateTime?
}

/// A member's Google connection for the Photos Picker: only the encrypted refresh token, usable by that member alone.
model GoogleAccount {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedRefreshToken String
  connectedAt           DateTime @default(now())
  lastUsedAt            DateTime?
  /// Set when Google refused the refresh token (testing-mode expiry, revocation): the member must reconnect.
  needsReconnect        Boolean  @default(false)
}

model PhotoLink {
  id        String        @id @default(cuid())
  photoAId  String
  photoBId  String
  photoA    Photo         @relation("LinkA", fields: [photoAId], references: [id], onDelete: Cascade)
  photoB    Photo         @relation("LinkB", fields: [photoBId], references: [id], onDelete: Cascade)
  relation  PhotoRelation
  note      String?
  createdAt DateTime      @default(now())

  @@unique([photoAId, photoBId, relation])
  @@index([photoBId])
}

model Track {
  id           String      @id @default(cuid())
  tripId       String
  trip         Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity     Activity?   @relation("ActivityTrack")
  uploaderId   String
  uploader     User        @relation(fields: [uploaderId], references: [id])
  source       TrackSource
  name         String
  originalFile String?
  startTime    DateTime
  endTime      DateTime
  pointCount   Int
  minLat       Float
  maxLat       Float
  minLng       Float
  maxLng       Float
  simplified   Json
  pointsBlob   Bytes
  hasElevation Boolean     @default(false)
  hasHeartRate Boolean     @default(false)
  hasCadence   Boolean     @default(false)
  hasPower     Boolean     @default(false)
  stats        TrackStats?
  createdAt    DateTime    @default(now())

  @@index([tripId, startTime])
  @@index([startTime, endTime])
}

model TrackStats {
  trackId         String @id
  track           Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  distanceM       Float
  movingTimeS     Int
  elapsedTimeS    Int
  elevGainM       Float?
  elevLossM       Float?
  minEleM         Float?
  maxEleM         Float?
  avgSpeedMs      Float?
  maxSpeedMs      Float?
  avgHr           Int?
  maxHr           Int?
  avgCadence      Int?
  maxCadence      Int?
  avgPower        Int?
  maxPower        Int?
  normalizedPower Int?
  calories        Int?
}
