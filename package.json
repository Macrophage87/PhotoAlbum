    "@types/react-dom": "^19",
    "@types/stream-json": "^1.7.8",
    "@types/tz-lookup": "^6.1.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
