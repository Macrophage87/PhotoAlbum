    "date-fns": "^4.4.0",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.11.1",
    "fit-file-parser": "^5.0.2",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "heic-convert": "^2.1.0",
    "maplibre-gl": "^6.7.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "sigma": "^3.0.3",
    "stream-chain": "^4.2.5",
