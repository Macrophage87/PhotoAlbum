# --- Core ---
# Public URL of the app (used in magic-link emails)
APP_URL=http://localhost:3000
# Postgres connection string for running outside Docker. Inside docker compose the app is pointed at
# the `db` service automatically using the POSTGRES_* values below.
DATABASE_URL=postgresql://photoalbum:photoalbum@localhost:5432/photoalbum

# Database credentials used by the `db` container. Change the password before exposing the host to the internet.
POSTGRES_USER=photoalbum
POSTGRES_PASSWORD=photoalbum
POSTGRES_DB=photoalbum
# Host port to publish the app on.
APP_PORT=3000

# The first person to sign in with this address becomes the admin.
ADMIN_EMAIL=you@example.com

# --- Email (magic links + invites) ---
# Leave SMTP_HOST empty to print links to the server log instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Family Album <album@example.com>"

# --- Storage ---
STORAGE_DRIVER=local
PHOTO_STORAGE_ROOT=/data/photos
MAX_UPLOAD_BYTES=104857600
MAX_IMPORT_BYTES=2147483648

# --- Background jobs ---
# Run the pg-boss worker inside the web process (true). Set false and start the optional worker container
# (`docker compose --profile worker up -d`) to process photos and imports in a separate process.
RUN_WORKER=true

# --- Maps (optional) ---
# Raster tile template, e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_URL=
# Full MapLibre style JSON URL (overrides NEXT_PUBLIC_TILE_URL)
NEXT_PUBLIC_MAP_STYLE_URL=
# Glyph (font) URL template for map labels when using the raster basemap
NEXT_PUBLIC_MAP_GLYPHS_URL=
# NEXT_PUBLIC_* values are compiled into the browser bundle: run `docker compose up --build` after changing them.
