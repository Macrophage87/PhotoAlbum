# --- Core ---
# Public URL of the app (used in magic-link emails)
APP_URL=http://localhost:3000
# Postgres connection string for running outside Docker. Inside docker compose the app is pointed at
# the `db` service automatically using the POSTGRES_* values below.
DATABASE_URL=postgresql://photoalbum:photoalbum@localhost:5432/photoalbum

# Database credentials used by the `db` container. Change the password before exposing the host to the internet.
POSTGRES_USER=photoalbum
POSTGRES_PASSWORD=photoalbum
POSTGRES_DB=photoalbum
# Host port to publish the app on.
APP_PORT=3000

# The first person to sign in with this address becomes the admin.
ADMIN_EMAIL=you@example.com

# --- Email (magic links + invites) ---
# Leave SMTP_HOST empty to print links to the server log instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Family Album <album@example.com>"

# --- Storage ---
STORAGE_DRIVER=local
PHOTO_STORAGE_ROOT=/data/photos
MAX_UPLOAD_BYTES=104857600
# Short clips are transcoded here; anything longer belongs on YouTube. Phone video runs 65 to 400 MB per minute.
MAX_CLIP_SECONDS=90
MAX_VIDEO_UPLOAD_BYTES=1073741824
MAX_IMPORT_BYTES=2147483648

# --- Background jobs ---
# Run the pg-boss worker inside the web process (true). Set false and start the optional worker container
# (`docker compose --profile worker up -d`) to process photos and imports in a separate process.
RUN_WORKER=true

# --- Maps (optional) ---
# Raster tile template, e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_URL=
# Full MapLibre style JSON URL (overrides NEXT_PUBLIC_TILE_URL)
NEXT_PUBLIC_MAP_STYLE_URL=
# Glyph (font) URL template for map labels when using the raster basemap
NEXT_PUBLIC_MAP_GLYPHS_URL=
# NEXT_PUBLIC_* values are compiled into the browser bundle: run `docker compose up --build` after changing them.

# --- YouTube embeds (optional) ---
# Optional Data API v3 key, only used to record each embedded video's duration.
YOUTUBE_API_KEY=
# Test doubles for the YouTube endpoints (the e2e suite points them at a mock server); leave empty.
YOUTUBE_OEMBED_URL=
YOUTUBE_THUMBNAIL_URL=
YOUTUBE_DATA_API_URL=

# --- AI descriptions (optional, off by default) ---
# Both gates must hold before anything is sent: this flag plus an admin's opt-in on the Admin page.
ANNOTATION_ENABLED=false
# Point the helper at a proxy or a mock server (tests use this); leave empty for api.anthropic.com.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# claude-opus-5 (default, best), claude-sonnet-5, or claude-haiku-4-5
ANNOTATION_MODEL=claude-opus-5
# Minutes without changes before an unreviewed item is sent (marking it reviewed sends it at once).
ANNOTATION_QUIET_MINUTES=30
# Days to keep the helper's raw responses for debugging.
ANNOTATION_RAW_RETENTION_DAYS=30

# --- Local ML sidecar (optional) ---
# Faces, image and text embeddings, run locally in the `ml` container; nothing leaves the server.
# Set both, run `docker compose run --rm ml-init` once, then `docker compose --profile ml up -d`.
# The app refuses to start with ML_URL set and ML_TOKEN empty. Needs about 2 GB of RAM for the sidecar alone.
ML_URL=
ML_TOKEN=
ML_IDLE_UNLOAD_SECONDS=300

# --- Faces (optional, off by default) ---
# Detection needs the ML sidecar, this flag, and an admin's opt-in on the Admin page. Templates stay in this database.
FACE_INDEXING_ENABLED=false
# Faces nobody names are deleted after this many days.
FACE_UNNAMED_RETENTION_DAYS=180

# --- Google Photos (optional) ---
# Whole-library import: copy Takeout zip files into this folder on the server (the compose file mounts the `imports`
# volume there) and import them from the Admin page. Leave empty to hide the section.
IMPORT_INBOX_DIR=/data/imports
# Pick-a-few import: an OAuth client (Web application) from Google Cloud with the Photos Picker API enabled and
# `<APP_URL>/api/google/callback` as its redirect URI. Each member connects their own account from the Upload page.
# Refresh tokens are stored encrypted under TOKEN_ENCRYPTION_KEY (32 random bytes, base64: `openssl rand -base64 32`).
# Rotating the key means every member connects again. All three are required together; leave empty to hide the button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Pets (optional, on by default) ---
# Animal spotting through the ML sidecar: a tagged pet is proposed on later look-alikes as "Probably Biscuit?". Needs ML_URL.
PET_MATCHING_ENABLED=true

# --- Address lookup (optional, on by default) ---
# "Set a place" can look up a town or landmark. The query goes from the server to a Nominatim-compatible endpoint
# (OpenStreetMap's public one by default, which allows light, user-initiated use). Set GEOCODER_ENABLED=false to keep
# everything on the map click, or GEOCODER_URL to your own Nominatim.
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Security headers ---
# Pages get a nonce-based Content-Security-Policy that allows scripts from this site only, plus images and data
# from the map hosts above. Set to true to report violations instead of blocking them while trying a new tile host.
CSP_REPORT_ONLY=false
